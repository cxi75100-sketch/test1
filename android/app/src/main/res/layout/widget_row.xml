<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- 课程色条。不能用 View 控件：RemoteViews 只允许 @RemoteView 注解的类，
         使用 android.view.View 会让整个小组件 inflate 失败。 -->
    <TextView
        android:id="@+id/widget_row_color"
        android:layout_width="3dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/widget_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:minWidth="78dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_row_classroom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="72dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
